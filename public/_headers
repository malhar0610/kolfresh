# ---------------------------------------------------------------------------
# Cloudflare Pages response headers.
# Placed in public/ so it is copied to the site root on build.
# ---------------------------------------------------------------------------

# Security headers applied to every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Never cache the HTML entry point (so new deploys are picked up immediately).
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build assets (index-<hash>.js / .css) can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Local SVG placeholder imagery — cache for a month.
/img/*
  Cache-Control: public, max-age=2592000
